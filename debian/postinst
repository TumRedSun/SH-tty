#!/bin/sh
# postinst — после установки .deb пакета.
set -e

case "$1" in
    configure)
        echo ""
        echo "==> SHTTY installed!"
        echo ""
        echo "To enable:"
        echo "  sudo systemctl disable getty@tty1"
        echo "  sudo systemctl enable shtty@tty1"
        echo "  sudo reboot"
        echo ""
        echo "Config: /etc/shtty/config.toml"
        echo "User config: ~/.config/shtty/config.toml"
        echo ""
        echo "Rollback to agetty:"
        echo "  sudo systemctl disable shtty@tty1"
        echo "  sudo systemctl enable getty@tty1"
        echo ""
    ;;
esac

#DEBHELPER#
exit 0
