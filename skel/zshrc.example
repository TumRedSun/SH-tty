# ~/.zshrc — пример оформления для shtty.
#
# Пользователь может полностью заменить этот файл — shtty только
# запускает zsh, всё оформление prompt остаётся за пользователем.

# === Цвета (неоновая палитра по умолчанию) ===
autoload -U colors && colors
local THEME_BG=$'\e[48;5;234m'      # глубокий фиолетовый фон
local THEME_MAGENTA=$'\e[38;5;197m' # неоновая магента
local THEME_CYAN=$'\e[38;5;51m'     # неоновый циан
local THEME_DIM=$'\e[38;5;60m'      # тусклый серо-фиолетовый
local THEME_RESET=$'\e[0m'

# === Prompt с ASCII уголками ===
# ╭─ user@host ~
# ╰─❯
# Левая часть.
PROMPT='%F{197}╭─%f %F{51}%n%f%F{60}@%f%F{51}%m%f %F{60}%~%f
%F{197}╰─%f%F{197}❯%f %F{244}%#%f '

# Правая часть — время + git branch.
RPROMPT='%F{60}[%f%F{51}%T%f%F{60}]%f $(git_prompt_info)'

# Git prompt (упрощённый).
autoload -Uz vcs_info
precmd_vcs() {
    vcs_info
}
precmd_functions+=( precmd_vcs )
zstyle ':vcs_info:git:*' formats '%F{60}(%f%F{197}%b%f%F{60})%f'
zstyle ':vcs_info:git:*' actionformats '%F{60}(%f%F{197}%b%f%F{60}|%F{51}%a%f%F{60})%f'
setopt PROMPT_SUBST
RPROMPT='%F{60}[%f%F{51}%T%f%F{60}]%f ${vcs_info_msg_0_}'

# === История ===
HISTFILE=~/.zsh_history
HISTSIZE=10000
SAVEHIST=10000
setopt SHARE_HISTORY
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_SPACE

# === Aliases ===
alias ls='ls --color=auto'
alias ll='ls -lah --color=auto'
alias grep='grep --color=auto'
alias ..='cd ..'
alias ...='cd ../..'

# === Completions ===
autoload -Uz compinit && compinit
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'

# === Key bindings ===
bindkey -e  # emacs-style
bindkey '^[[A' history-search-backward  # Up
bindkey '^[[B' history-search-forward   # Down

# === Title bar (если поддерживается) ===
case $TERM in
    xterm-256color|screen*)
        precmd() { print -Pn "\e]0;%n@%m:%~\a" }
        ;;
esac

# === shtty welcome ===
if [[ -n "$SHTTY" ]]; then
    echo ""
    echo "  ${THEME_MAGENTA}╔════════════════════════════════════════╗${THEME_RESET}"
    echo "  ${THEME_MAGENTA}║${THEME_CYAN}   shtty  ${THEME_DIM}tile manager  ${THEME_MAGENTA}            ║${THEME_RESET}"
    echo "  ${THEME_MAGENTA}╠════════════════════════════════════════╣${THEME_RESET}"
    echo "  ${THEME_MAGENTA}║${THEME_RESET} ${THEME_DIM}Mod4+D${THEME_RESET} launcher    ${THEME_DIM}Mod4+1..9${THEME_RESET} ws    ${THEME_MAGENTA}║${THEME_RESET}"
    echo "  ${THEME_MAGENTA}║${THEME_RESET} ${THEME_DIM}Mod4+Enter${THEME_RESET} term    ${THEME_DIM}Mod4+E${THEME_RESET} X11 tile    ${THEME_MAGENTA}║${THEME_RESET}"
    echo "  ${THEME_MAGENTA}║${THEME_RESET} ${THEME_DIM}Mod4+Shift+1..9${THEME_RESET} move to ws            ${THEME_MAGENTA}║${THEME_RESET}"
    echo "  ${THEME_MAGENTA}╚════════════════════════════════════════╝${THEME_RESET}"
    echo ""
fi
