# Maintainer: SHTTY contributors
pkgname=shtty
pkgver=0.6.0
pkgrel=1
pkgdesc="Tile-based TTY window manager with X11 embedding, multi-monitor, PAM login screen"
arch=('x86_64' 'aarch64')
url="https://github.com/TumRedSun/SH-tty"
license=('MIT')
depends=(
    'systemd'
    'kbd'
    'zsh'
    'pam'
    'freetype2'
    'fontconfig'
    'ttf-dejavu'
)
optdepends=(
    'xorg-server-xvfb: X11 tile embedding (preferred, works on pure TTY)'
    'xorg-server-xephyr: X11 tile embedding (fallback, requires host X server)'
    'pipewire: audio support'
    'pipewire-pulse: PulseAudio compatibility'
    'wireplumber: PipeWire session manager'
    'xdg-desktop-portal: screen share support'
    'sdl2: gamepad button mapping (build with --features gamepad-sdl2)'
    'libvterm: full xterm compatibility'
)
makedepends=('rust' 'cargo' 'gcc' 'pkgconf')
# source заполняется build-packages.sh через sed (локальный tarball).
# При ручном запуске makepkg — скачивает с GitHub.
source=("$pkgname-$pkgver.tar.gz::https://github.com/TumRedSun/SH-tty/archive/v$pkgver.tar.gz")
sha256sums=('SKIP')
install=shtty.install

build() {
    cd "$srcdir"/SH-tty-$pkgver 2>/dev/null || cd "$srcdir"/shtty 2>/dev/null || cd "$srcdir"
    FEATURES=""
    if pkg-config --exists sdl2 2>/dev/null; then
        FEATURES="${FEATURES}gamepad-sdl2,"
    fi
    # pam is in depends=, so always available — enable for real PAM auth
    FEATURES="${FEATURES}pam,"
    FEATURES="${FEATURES%,}"
    cargo build --release --features "$FEATURES"
}

package() {
    cd "$srcdir"/SH-tty-$pkgver 2>/dev/null || cd "$srcdir"/shtty 2>/dev/null || cd "$srcdir"

    install -Dm755 target/release/shtty "$pkgdir/usr/local/bin/shtty"
    install -Dm644 systemd/shtty@.service "$pkgdir/etc/systemd/system/shtty@.service"
    install -Dm644 config/default.toml "$pkgdir/etc/shtty/config.toml"
    install -Dm644 skel/zshrc.example "$pkgdir/usr/share/shtty/skel/zshrc.example"
    install -Dm644 README.md "$pkgdir/usr/share/doc/shtty/README.md"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/shtty/LICENSE"
}
